{
  "name": "@epicurrents/wav-reader",
  "version": "0.0.0",
  "description": "Epicurrents WAV file reader",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:workers && npm run build:tsc",
    "build:lib": "vite build",
    "build:tsc": "npm run build:lib && npm run build:types",
    "build:types": "epicurrents-build-types",
    "build:workers": "node scripts/build-workers.mjs",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public && git push --follow-tags",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": "./dist/types/index.d.ts",
    "./workers/*": "./umd/*",
    "./package.json": "./package.json",
    "./dist/types": "./dist/types/index.d.ts",
    "./umd/*": "./umd/*"
  },
  "files": [
    "dist/*",
    "umd/*.js",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epicurrents/wav-reader.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "devDependencies": {
    "@epicurrents/core": "^2.1.0",
    "@eslint/js": "^9.18.0",
    "@stylistic/eslint-plugin": "^3.0.0",
    "@stylistic/eslint-plugin-ts": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "scoped-event-log": "^3.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@epicurrents/core": "^2.1.0",
    "scoped-event-log": "^3.2.0"
  },
  "dependencies": {
    "byte-data": "^19.0.1"
  }
}
